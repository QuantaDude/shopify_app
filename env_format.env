# Copy to .env.development (development) or .env (production) and fill in.

PORT=3000
APP_SECRET=<random string>

# Shopify app credentials and Admin API version (latest stable: 2026-10)
API_VERSION=2026-10
API_SECRET=<shopify app client secret>
API_KEY=<shopify app client ID>

# Public URL of the app (must match the Shopify app configuration)
APP_URL=<public app url>

CSRF_SECRET=<random string>

JWT_SECRET=<random string>
JWT_TOKEN_AUDIENCE=<app url>
JWT_TOKEN_ISSUER=localhost:3000
JWT_ACCESS_TOKEN_TTL=3600

# Logging: LOGGING=LOG,WARN,ERROR,DEBUG / LOG_TO_FILE=true
LOGGING=log,error,warn
LOG_TO_FILE=false

DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=<DB_USERNAME>
DB_PASSWORD=<PASSWORD>
DB_NAME=shopify_app
DB_SYNC=false
DB_AUTOLOAD=true
DB_RUN_MIGRATIONS=true

REDIS_HOST=localhost
REDIS_PORT=6379

# appSubscriptionCreate test charges (only accepted on dev stores);
# set to false for production billing
BILLING_TEST_MODE=true

# Set to true if the app is an embedded app (currently unused, defaults false)
SHOPIFY_APP_EMBEDDED=false
